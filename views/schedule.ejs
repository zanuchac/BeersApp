<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ตารางการติดตั้งผ้าม่านลูกค้า</title>
    <link rel="stylesheet" href="/css/stylesheet.css"> 
</head>
<body>

    <div class="dashboard-layout">
        
        <div class="sidebar">
            <div class="logo">BackOffice</div>

            <div class="user-status">
                <p>ผู้ใช้งาน:</p>
                <p><%= user.DisplayName %></p>
                <a href="/logout" class="logout-btn">ออกจากระบบ</a>
            </div>
            <nav>
                <a href="/input_order" class="nav-item">
                    + ทำ Order ใหม่
                </a>
                <a href="/search_order" class="nav-item">
                    ค้นหา/แก้ไข Order
                </a>
                <hr style="border-top: 1px solid #eee; margin: 10px 0;">
                <a href="/schedule" class="nav-item active">ตารางติดตั้ง</a>
                <a href="/report" class="nav-item">รายงาน</a>
            </nav>
        </div>

        <div class="main-content">
            <div class="schedule-header">
                <h2>ตารางงานติดตั้งประจำสัปดาห์</h2>
                <div class="controls">
                    <select id="team-filter">
                        <option value="all">ทีมช่างทั้งหมด</option>
                        <option value="team-a">ทีมช่าง A</option>
                        <option value="team-b">ทีมช่าง B</option>
                        </select>
                    <button id="prev-week-btn" class="nav-btn">ก่อนหน้า</button>
                    <span id="current-week-range"></span>
                    <button id="next-week-btn" class="nav-btn">ถัดไป</button>
                    <button href="/input_schedule" class="add-btn">+ เพิ่มงานใหม่</button>
                </div>
            </div>

            <% if (dbError) { %>
                <div class="error-message">
                    <strong>เกิดข้อผิดพลาด:</strong> <%= dbError %>
                </div>
            <% } %>
<div class="schedule-container">
                <table class="schedule-table">
                    <thead>
                        <tr>
                            <th>เวลา</th>
                            <th>จันทร์ 00/00</th>
                            <th>อังคาร 00/00</th>
                            <th>พุธ 00/00</th>
                            <th>พฤหัสบดี 00/00</th>
                            <th>ศุกร์ 00/00</th>
                            <th>เสาร์ 00/00</th>
                            <th>อาทิตย์ 00/00</th>
                        </tr>
                    </thead>
                    <tbody id="schedule-body">
                        <% if (jobs && jobs.length > 0) { %>
                            <% jobs.forEach(job => { %>
                                <tr>
                                    <td><%= job.time %></td>
                                    <td colspan="7">งาน: <%= job.customer %> | ทีม: <%= job.team %> | วันที่: <%= job.date %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="right-sidebar">
            <h3>งานที่กำลังจะมาถึง</h3>
            <div id="upcoming-jobs-list" class="job-list">
                <% if (jobs && jobs.length > 0) { %>
                    <% jobs.slice(0, 3).forEach(job => { %>
                        <div class="job-item">
                            <p><strong><%= job.customer %></strong></p>
                            <p><%= job.date %> @ <%= job.time %> (ทีม <%= job.team %>)</p>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

    </div>

    <script>
        // ข้อมูลผู้ใช้ที่ล็อกอินอยู่
        const currentUser = {
            id: '<%= user.UserId %>',
            displayName: '<%= user.DisplayName %>'
        };
        
        // ข้อมูลตารางงาน
        const liveJobs = <%- JSON.stringify(jobs || []) %>;
        
        console.log('Current User:', currentUser.displayName);
        console.log('Live Jobs Data Loaded:', liveJobs.length, 'jobs');
    </script>
    

    <script src="/js/schedule.js"></script> 

</body>
</html>